# =============================================================================
# config.env.example — central configuration template for NSM-IDS-2026 code.
#
#   cp config.env.example config.env     # then edit values below
#
# All bash scripts `source config.env`; Python reads values via os.environ.
# `config.env` is .gitignored (it may hold values you choose). NEVER commit real
# SSH keys, tokens, or passwords. All values here are LAB-ONLY synthetic defaults
# for a fully isolated network — none correspond to a real account or service.
# =============================================================================

# --- Isolated network ------------------------------------------------------
NET_NAME="ids-isolated"          # libvirt network name
NET_BRIDGE="virbr-ids"           # bridge interface (capture happens here)
NET_SUBNET="10.10.10.0/24"
NET_NETMASK="255.255.255.0"
HOST_IP="10.10.10.1"             # host IP on the isolated net (sensor role)

ATTACKER_IP="10.10.10.20"
VICTIM_IP="10.10.10.30"
MSF_IP="10.10.10.40"             # optional metasploitable2

# Host LAN gateway used by isolation_check.sh to confirm the VMs CANNOT reach it.
# Leave empty to auto-detect from the host default route (recommended).
LAN_GW=""

# --- Capture ---------------------------------------------------------------
CAPTURE_IFACE="virbr-ids"        # host sniffs this interface (all L2 traffic)

# --- VMs -------------------------------------------------------------------
ATTACKER_NAME="ids-attacker"
VICTIM_NAME="ids-victim"
MSF_NAME="ids-metasploitable2"
ATTACKER_DISTRO="kali"           # "kali" (default) or "ubuntu" (reproducible fallback)
VICTIM_VCPUS=2;   VICTIM_RAM_MB=4096;   VICTIM_DISK_GB=25
ATTACKER_VCPUS=2; ATTACKER_RAM_MB=4096; ATTACKER_DISK_GB=25

# --- Credentials (LAB-ONLY synthetic values for the isolated net) ----------
# These passwords are deliberately weak: they are the TARGET of the in-lab SSH
# brute-force scenario so it produces realistic traffic/logs. They do NOT belong
# to any real account or service and never leave the isolated network.
# CHANGE the password below; the brute-force wordlist appends it so cracking
# succeeds (realistic auth-failure/success logs).
VICTIM_USER="analyst"            # normal admin account (SSH-key login)
BRUTE_USER="svc"                 # brute-force target (weak-password lab account)
BRUTE_PASSWORD="CHANGE_ME_weak_lab_password"
ATTACKER_USER="attacker"

# Isolated-lab SSH key (passwordless), generated on the host and pushed to VMs.
# Generate your own: ssh-keygen -t ed25519 -N '' -f keys/id_ids
# keys/ is .gitignored — NEVER commit a private key.
SSH_KEY="keys/id_ids"

# --- VM images (downloaded over the host Internet; VMs stay isolated) ------
IMG_DIR="images"
UBUNTU_IMG_URL="https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
KALI_IMG_DIR_URL="https://kali.download/cloud-images/current/"
KALI_IMG_URL="https://kali.download/cloud-images/current/kali-linux-2026.2-cloud-genericcloud-amd64.tar.xz"

# --- Host logging (Wazuh) --------------------------------------------------
# "full"  = Wazuh manager (Docker single-node) + agent  (host RAM >= 32 GB)
# "light" = auditd + file copy                           (host RAM < 32 GB)
WAZUH_MODE="full"
WAZUH_VERSION="4.14.8"           # manager (Docker) and agent (apt) MUST match
WAZUH_MANAGER_NAME="wazuh-manager"
WAZUH_MANAGER_ADDR="10.10.10.1"  # agent reaches the manager at the host sensor IP

# --- Optional components ---------------------------------------------------
ENABLE_METASPLOITABLE2="false"
ENABLE_LOCAL_LLM="false"
ENABLE_XGBOOST="true"

# --- Scenario timing (env-overridable for campaign variation) --------------
: "${GAP_SECONDS:=45}"           # silence between attacks (30-60 s)
: "${DOS_DURATION:=8}"           # hping3 SYN-flood duration (s), short/bounded
SLOW_DOS_DURATION=25             # slow-DoS (slowloris/slowhttp/goldeneye) duration (s)
